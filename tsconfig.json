{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./frontend/src/*"
      ]
    }
  },
  "include": [
    "frontend/src/**/*",
    "frontend/next-env.d.ts",
    "frontend/.next/types/**/*.ts",
    "backend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "frontend/.next",
    "backend/dist"
  ]
}